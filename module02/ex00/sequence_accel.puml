@startuml sequence_accel
' Bonus 4 : acceleration scenario
skinparam shadowing false
skinparam dpi 150
title Acceleration - Pedal -> Injector -> Wheels

actor Driver
participant Cockpit
participant Pedal as "Pedal\n(target = Injector)"
participant Injector
participant ExplosionChamber as "Explosion\nChamber"
participant Crankshaft
participant Transmission
participant Wheel

Driver -> Cockpit : pressPedal(pression)
activate Cockpit
Cockpit -> Pedal : use(pression)
activate Pedal
Pedal -> Injector : execute(pression)
activate Injector
Injector -> ExplosionChamber : fill(volume)
activate ExplosionChamber
ExplosionChamber -> Crankshaft : receiveForce(volume)
activate Crankshaft
Crankshaft -> Transmission : activate(force)
activate Transmission
Transmission -> Wheel : executeRotation(force)
activate Wheel
Wheel --> Transmission : rolling
deactivate Wheel
deactivate Transmission
deactivate Crankshaft
deactivate ExplosionChamber
deactivate Injector
deactivate Pedal
deactivate Cockpit

note over Pedal, Injector
  The pedal only knows the
  LinkablePart interface:
  setTarget() selected the
  Injector beforehand.
end note
@enduml
