@startuml sequence_brake
' Bonus 4 : braking scenario
skinparam shadowing false
skinparam dpi 150
title Braking - Pedal -> BrakeController -> Wheels

actor Driver
participant Cockpit
participant Pedal as "Pedal\n(target = BrakeController)"
participant BrakeController as "Brake\nController"
participant Brake
participant Wheel

Driver -> Cockpit : pressPedal(pression)
activate Cockpit
Cockpit -> Pedal : use(pression)
activate Pedal
Pedal -> BrakeController : execute(pression)
activate BrakeController
loop over each Brake
  BrakeController -> Brake : execute(force)
  activate Brake
  Brake -> Wheel : attackWheel(wheel)\n+ execute(force)
  activate Wheel
  Wheel --> Brake : braking
  deactivate Wheel
  deactivate Brake
end
deactivate BrakeController
deactivate Pedal
deactivate Cockpit

note over Pedal, BrakeController
  Same Pedal interface as acceleration:
  only the LinkablePart target
  changes (polymorphism).
end note
@enduml
